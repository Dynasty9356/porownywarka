# ========================================================
# FolderSync - Git Ignore Configuration
# Wysyłaj TYLKO niezbędny kod źródłowy, testy i konfigurację
# ========================================================

# Środowisko wirtualne Pythona
.venv/
venv/
env/
ENV/

# Pamięć podręczna kompilatora Pythona (Bytecode Cache)
**/__pycache__/
*.py[cod]
*$py.class
*.pyo

# Wyniki budowania aplikacji i pliki binarne
build/
dist/
output_installer/
*.exe
*.dll
*.pyd
*.so
*.dylib
*.bin

# Logi, raporty tymczasowe i zrzuty wykonania
*.log
*_log.txt
build_log.txt
inno_log.txt
fix_out.txt
test_run.txt

# Kopie zapasowe synchronizatora i pliki tymczasowe
.backup/
**/.backup/
*.tmp
*.bak
*.swp
*.swo

# Środowiska deweloperskie i edytory (IDE)
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Zmienne środowiskowe i wrażliwe dane (Security CERT)
.env
.env.*
!.env.example

# Pliki systemowe Windows i macOS
Thumbs.db
ehthumbs.db
Desktop.ini
desktop.ini
$RECYCLE.BIN/
.DS_Store
._*
.Spotlight-V100
.Trashes